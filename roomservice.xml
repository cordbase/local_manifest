<?xml version="1.0" encoding="UTF-8"?>
<manifest>
    <!-- Remotes -->
    <remote name="cordbase" fetch="https://github.com/cordbase" revision="dotos" />
    <remote name="sourajitk" fetch="https://github.com/sourajitk" revision="11" />
    <remote name="los" fetch="https://github.com/LineageOS" revision="lineage-18.1" />

    <!-- Device tree -->
    <project name="android_device_google_sunfish" path="device/google/sunfish" remote="cordbase" />

    <!-- Vendor tree -->
